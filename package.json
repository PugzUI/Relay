{
  "name": "@pugzui/relay",
  "version": "0.1.0",
  "description": "Device-qualified relays, boards, and topology view",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "bin": {
    "relay": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./opencode-plugin": {
      "import": "./src/adapters/index.mjs"
    }
  },
  "files": [
    "src/",
    "ui/",
    "LICENSE"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "prepack": "npm run build:ui",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "typescript": "5.9.3"
  }
}
