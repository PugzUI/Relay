root = true

[*]
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100
indent_size = 2
charset = utf-8
end_of_line = lf
indent_style = space

[*.py]
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[tests/renderer-comparison/vendor/pixi.min.mjs]
trim_trailing_whitespace = false
